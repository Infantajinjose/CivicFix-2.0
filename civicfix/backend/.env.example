PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/civicfix
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=5

# Optional: Google Gemini API Key for Advanced AI Features (Transparent Rule-engine fallback active by default)
GEMINI_API_KEY=

# Optional: Razorpay Test Mode Credentials (Sandbox Mock Upgrade active by default)
RAZORPAY_KEY_ID=rzp_test_civicfix_sandbox
RAZORPAY_KEY_SECRET=rzp_test_secret_sandbox
